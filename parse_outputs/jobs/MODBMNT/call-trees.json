  "DynamicContent": {
    "dd://3a77d876:MODBMNT.STEP10.SYSTSIN": "  DSN SYSTEM(DS13)\n  RUN PROGRAM(CBMOD04C) PLAN(CARDMODB)\n  END\n",
    "subset://SQL(file://app-mo-db2/cbl/CBMOD04C.cbl)": "SQLCA\nDCLTRHST\nDECLARE CARDDEMO.TRAN_HIST TABLE\n( TH_TRAN_ID                     CHAR(16) NOT NULL,\nTH_ACCT_ID                     DECIMAL(11, 0) NOT NULL,\nTH_CARD_NUM                    CHAR(16) NOT NULL,\nTH_TYPE_CD                     CHAR(2) NOT NULL,\nTH_CAT_CD                      CHAR(4) NOT NULL,\nTH_SOURCE                      CHAR(10) NOT NULL,\nTH_DESC                        VARCHAR(100) NOT NULL,\nTH_AMT                         DECIMAL(11, 2) NOT NULL,\nTH_MERCHANT_ID                 DECIMAL(9, 0),\nTH_MERCHANT_NAME               VARCHAR(50),\nTH_MERCHANT_CITY               VARCHAR(50),\nTH_MERCHANT_ZIP                CHAR(10),\nTH_TRAN_DATE                   DATE NOT NULL,\nTH_ORIG_TS                     TIMESTAMP NOT NULL,\nTH_PROC_TS                     TIMESTAMP\n)\nDCLACDBL\nDECLARE CARDDEMO.ACCT_DAILY_BAL TABLE\n( ADB_ACCT_ID                    DECIMAL(11, 0) NOT NULL,\nADB_BAL_DATE                   DATE NOT NULL,\nADB_OPEN_BAL                   DECIMAL(12, 2) NOT NULL,\nADB_CREDIT_AMT                 DECIMAL(12, 2) NOT NULL,\nADB_DEBIT_AMT                  DECIMAL(12, 2) NOT NULL,\nADB_CLOSE_BAL                  DECIMAL(12, 2) NOT NULL,\nADB_TRAN_CNT                   INTEGER NOT NULL,\nADB_CREDIT_LIMIT               DECIMAL(12, 2) NOT NULL,\nADB_OVERLIMIT_FLG              CHAR(1) NOT NULL,\nADB_FLAG_DATE                  DATE\n)\nDECLARE C-OVERLIMIT CURSOR WITH HOLD FOR\nSELECT ADB_ACCT_ID\n, ADB_CLOSE_BAL\n, ADB_CREDIT_LIMIT\n, ADB_OVERLIMIT_FLG\nFROM CARDDEMO.ACCT_DAILY_BAL\nWHERE ADB_BAL_DATE = :WS-ASOF-DATE\nFOR UPDATE OF ADB_OVERLIMIT_FLG\n, ADB_FLAG_DATE\nSELECT CHAR(DATE(:WS-PARM-DATE), ISO)\n, CHAR(DATE(DAYS(DATE(:WS-PARM-DATE))\n- :WS-RETAIN-DAYS), ISO)\nINTO :WS-ASOF-DATE\n, :WS-CUTOFF-DATE\nFROM SYSIBM.SYSDUMMY1\nOPEN C-OVERLIMIT\nFETCH C-OVERLIMIT\nINTO :DCL-ADB-ACCT-ID\n, :DCL-ADB-CLOSE-BAL\n, :DCL-ADB-CREDIT-LIMIT\n, :DCL-ADB-OVERLIMIT-FLG\nCLOSE C-OVERLIMIT\nUPDATE CARDDEMO.ACCT_DAILY_BAL\nSET ADB_OVERLIMIT_FLG = :DCL-ADB-OVERLIMIT-FLG\n, ADB_FLAG_DATE     = :DCL-ADB-FLAG-DATE\n:WS-IND-FLAG-DATE\nWHERE CURRENT OF C-OVERLIMIT\nSELECT COUNT(*)\nINTO :WS-PURGE-CANDIDATES\nFROM CARDDEMO.TRAN_HIST\nWHERE TH_TRAN_DATE < :WS-CUTOFF-DATE\nDELETE FROM CARDDEMO.TRAN_HIST\nWHERE TH_TRAN_DATE < :WS-CUTOFF-DATE\nCOMMIT\nROLLBACK"
  },
