  "DynamicContent": {
    "dd://60a20abd:MODBBAL.STEP10.SYSTSIN": "  DSN SYSTEM(DS13)\n  RUN PROGRAM(CBMOD02C) PLAN(CARDMODB)\n  END\n",
    "subset://SQL(file://app-mo-db2/cbl/CBMOD02C.cbl)": "SQLCA\nDCLTRHST\nDECLARE CARDDEMO.TRAN_HIST TABLE\n( TH_TRAN_ID                     CHAR(16) NOT NULL,\nTH_ACCT_ID                     DECIMAL(11, 0) NOT NULL,\nTH_CARD_NUM                    CHAR(16) NOT NULL,\nTH_TYPE_CD                     CHAR(2) NOT NULL,\nTH_CAT_CD                      CHAR(4) NOT NULL,\nTH_SOURCE                      CHAR(10) NOT NULL,\nTH_DESC                        VARCHAR(100) NOT NULL,\nTH_AMT                         DECIMAL(11, 2) NOT NULL,\nTH_MERCHANT_ID                 DECIMAL(9, 0),\nTH_MERCHANT_NAME               VARCHAR(50),\nTH_MERCHANT_CITY               VARCHAR(50),\nTH_MERCHANT_ZIP                CHAR(10),\nTH_TRAN_DATE                   DATE NOT NULL,\nTH_ORIG_TS                     TIMESTAMP NOT NULL,\nTH_PROC_TS                     TIMESTAMP\n)\nDCLACDBL\nDECLARE CARDDEMO.ACCT_DAILY_BAL TABLE\n( ADB_ACCT_ID                    DECIMAL(11, 0) NOT NULL,\nADB_BAL_DATE                   DATE NOT NULL,\nADB_OPEN_BAL                   DECIMAL(12, 2) NOT NULL,\nADB_CREDIT_AMT                 DECIMAL(12, 2) NOT NULL,\nADB_DEBIT_AMT                  DECIMAL(12, 2) NOT NULL,\nADB_CLOSE_BAL                  DECIMAL(12, 2) NOT NULL,\nADB_TRAN_CNT                   INTEGER NOT NULL,\nADB_CREDIT_LIMIT               DECIMAL(12, 2) NOT NULL,\nADB_OVERLIMIT_FLG              CHAR(1) NOT NULL,\nADB_FLAG_DATE                  DATE\n)\nDECLARE C-DAY-ACTIVITY CURSOR WITH HOLD FOR\nSELECT TH_ACCT_ID\n, SUM(CASE WHEN TH_AMT >= 0\nTHEN TH_AMT ELSE 0 END)\n, SUM(CASE WHEN TH_AMT < 0\nTHEN TH_AMT ELSE 0 END)\n, SUM(TH_AMT)\n, COUNT(*)\nFROM CARDDEMO.TRAN_HIST\nWHERE TH_TRAN_DATE = :WS-BAL-DATE\nGROUP BY TH_ACCT_ID\nORDER BY TH_ACCT_ID\nSELECT CHAR(DATE(:WS-PARM-DATE), ISO)\nINTO :WS-BAL-DATE\nFROM SYSIBM.SYSDUMMY1\nOPEN C-DAY-ACTIVITY\nFETCH C-DAY-ACTIVITY\nINTO :DCL-TH-ACCT-ID\n, :WS-DAY-CREDITS\n, :WS-DAY-DEBITS\n, :WS-DAY-NET\n, :WS-DAY-COUNT\nCLOSE C-DAY-ACTIVITY\nSELECT MAX(ADB_BAL_DATE)\nINTO :WS-PREV-BAL-DATE :WS-IND-PREV-BAL-DATE\nFROM CARDDEMO.ACCT_DAILY_BAL\nWHERE ADB_ACCT_ID  = :DCL-TH-ACCT-ID\nAND ADB_BAL_DATE < :WS-BAL-DATE\nSELECT ADB_CLOSE_BAL\nINTO :WS-PREV-CLOSE-BAL\nFROM CARDDEMO.ACCT_DAILY_BAL\nWHERE ADB_ACCT_ID  = :DCL-TH-ACCT-ID\nAND ADB_BAL_DATE = :WS-PREV-BAL-DATE\nSELECT SUM(TH_AMT)\nINTO :WS-LATER-NET :WS-IND-LATER-NET\nFROM CARDDEMO.TRAN_HIST\nWHERE TH_ACCT_ID    = :DCL-TH-ACCT-ID\nAND TH_TRAN_DATE >= :WS-BAL-DATE\nINSERT INTO CARDDEMO.ACCT_DAILY_BAL\n( ADB_ACCT_ID\n, ADB_BAL_DATE\n, ADB_OPEN_BAL\n, ADB_CREDIT_AMT\n, ADB_DEBIT_AMT\n, ADB_CLOSE_BAL\n, ADB_TRAN_CNT\n, ADB_CREDIT_LIMIT\n, ADB_OVERLIMIT_FLG\n, ADB_FLAG_DATE\n)\nVALUES\n( :DCL-ADB-ACCT-ID\n, :DCL-ADB-BAL-DATE\n, :DCL-ADB-OPEN-BAL\n, :DCL-ADB-CREDIT-AMT\n, :DCL-ADB-DEBIT-AMT\n, :DCL-ADB-CLOSE-BAL\n, :DCL-ADB-TRAN-CNT\n, :DCL-ADB-CREDIT-LIMIT\n, 'N'\n, NULL\n)\nUPDATE CARDDEMO.ACCT_DAILY_BAL\nSET ADB_OPEN_BAL      = :DCL-ADB-OPEN-BAL\n, ADB_CREDIT_AMT    = :DCL-ADB-CREDIT-AMT\n, ADB_DEBIT_AMT     = :DCL-ADB-DEBIT-AMT\n, ADB_CLOSE_BAL     = :DCL-ADB-CLOSE-BAL\n, ADB_TRAN_CNT      = :DCL-ADB-TRAN-CNT\n, ADB_CREDIT_LIMIT  = :DCL-ADB-CREDIT-LIMIT\n, ADB_OVERLIMIT_FLG = 'N'\n, ADB_FLAG_DATE     = NULL\nWHERE ADB_ACCT_ID  = :DCL-ADB-ACCT-ID\nAND ADB_BAL_DATE = :DCL-ADB-BAL-DATE\nCOMMIT\nROLLBACK"
  },
