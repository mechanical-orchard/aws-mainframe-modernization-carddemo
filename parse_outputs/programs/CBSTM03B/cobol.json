      "Lines": [
        "       IDENTIFICATION DIVISION.",
        "       PROGRAM-ID.    CBSTM03B.",
        "       AUTHOR.        AWS.",
        "      ******************************************************************",
        "      * Program     : CBSTM03B.CBL",
        "      * Application : CardDemo",
        "      * Type        : BATCH COBOL Subroutine",
        "      * Function    : Does file processing related to Transact Report",
        "      ******************************************************************",
        "      * Copyright Amazon.com, Inc. or its affiliates.",
        "      * All Rights Reserved.",
        "      *",
