  CREATE TABLESPACE MOTHST01
    IN CARDMODB
    SEGSIZE 4
    LOCKSIZE TABLE
    BUFFERPOOL BP0
    CLOSE NO
    CCSID EBCDIC;

  COMMIT;

  GRANT USE OF TABLESPACE CARDMODB.MOTHST01
        TO PUBLIC;

  CREATE TABLE CARDDEMO.TRAN_HIST
       (TH_TRAN_ID          CHAR(16)       NOT NULL,
        TH_ACCT_ID          DECIMAL(11,0)  NOT NULL,
        TH_CARD_NUM         CHAR(16)       NOT NULL,
        TH_TYPE_CD          CHAR(2)        NOT NULL,
        TH_CAT_CD           CHAR(4)        NOT NULL,
        TH_SOURCE           CHAR(10)       NOT NULL,
        TH_DESC             VARCHAR(100)   NOT NULL,
        TH_AMT              DECIMAL(11,2)  NOT NULL,
        TH_MERCHANT_ID      DECIMAL(9,0),
        TH_MERCHANT_NAME    VARCHAR(50),
        TH_MERCHANT_CITY    VARCHAR(50),
        TH_MERCHANT_ZIP     CHAR(10),
        TH_TRAN_DATE        DATE           NOT NULL,
        TH_ORIG_TS          TIMESTAMP      NOT NULL,
        TH_PROC_TS          TIMESTAMP,
        PRIMARY KEY(TH_TRAN_ID))
     IN CARDMODB.MOTHST01
     CCSID EBCDIC;

  COMMIT;

  CREATE UNIQUE INDEX CARDDEMO.XTRANH01
     ON CARDDEMO.TRAN_HIST
       (TH_TRAN_ID      ASC)
     BUFFERPOOL BP0
     CLOSE NO;

  CREATE INDEX CARDDEMO.XTRANH02
     ON CARDDEMO.TRAN_HIST
       (TH_TRAN_DATE    ASC,
        TH_ACCT_ID      ASC)
     BUFFERPOOL BP0
     CLOSE NO;

  COMMIT;

  CREATE TABLESPACE MOADBL01
    IN CARDMODB
    SEGSIZE 4
    LOCKSIZE TABLE
    BUFFERPOOL BP0
    CLOSE NO
    CCSID EBCDIC;

  COMMIT;

  GRANT USE OF TABLESPACE CARDMODB.MOADBL01
        TO PUBLIC;

  CREATE TABLE CARDDEMO.ACCT_DAILY_BAL
       (ADB_ACCT_ID         DECIMAL(11,0)  NOT NULL,
        ADB_BAL_DATE        DATE           NOT NULL,
        ADB_OPEN_BAL        DECIMAL(12,2)  NOT NULL,
        ADB_CREDIT_AMT      DECIMAL(12,2)  NOT NULL,
        ADB_DEBIT_AMT       DECIMAL(12,2)  NOT NULL,
        ADB_CLOSE_BAL       DECIMAL(12,2)  NOT NULL,
        ADB_TRAN_CNT        INTEGER        NOT NULL,
        ADB_CREDIT_LIMIT    DECIMAL(12,2)  NOT NULL,
        ADB_OVERLIMIT_FLG   CHAR(1)        NOT NULL WITH DEFAULT 'N',
        ADB_FLAG_DATE       DATE,
        PRIMARY KEY(ADB_ACCT_ID, ADB_BAL_DATE))
     IN CARDMODB.MOADBL01
     CCSID EBCDIC;

  COMMIT;

  CREATE UNIQUE INDEX CARDDEMO.XACDBL01
     ON CARDDEMO.ACCT_DAILY_BAL
       (ADB_ACCT_ID     ASC,
        ADB_BAL_DATE    ASC)
     BUFFERPOOL BP0
     CLOSE NO;

  COMMIT;

  CREATE TABLESPACE MOAREQ01
    IN CARDMODB
    SEGSIZE 4
    LOCKSIZE TABLE
    BUFFERPOOL BP0
    CLOSE NO
    CCSID EBCDIC;

  COMMIT;

  GRANT USE OF TABLESPACE CARDMODB.MOAREQ01
        TO PUBLIC;

  CREATE TABLE CARDDEMO.ACCT_REQUEST
       (REQ_ID              CHAR(12)       NOT NULL,
        REQ_ACTION          CHAR(1)        NOT NULL,
        REQ_ACCT_ID         DECIMAL(11,0)  NOT NULL,
        REQ_BAL_DATE        DATE           NOT NULL,
        REQ_CARD_NUM        CHAR(16),
        REQ_AMT             DECIMAL(11,2),
        REQ_DESC            VARCHAR(100),
        REQ_STATUS          CHAR(1)        NOT NULL WITH DEFAULT 'P',
        REQ_REASON          CHAR(8),
        REQ_TRAN_ID         CHAR(16),
        PRIMARY KEY(REQ_ID))
     IN CARDMODB.MOAREQ01
     CCSID EBCDIC;

  COMMIT;

  CREATE UNIQUE INDEX CARDDEMO.XACREQ01
     ON CARDDEMO.ACCT_REQUEST
       (REQ_ID          ASC)
     BUFFERPOOL BP0
     CLOSE NO;

  CREATE INDEX CARDDEMO.XACREQ02
     ON CARDDEMO.ACCT_REQUEST
       (REQ_STATUS      ASC,
        REQ_ID          ASC)
     BUFFERPOOL BP0
     CLOSE NO;

  COMMIT;
