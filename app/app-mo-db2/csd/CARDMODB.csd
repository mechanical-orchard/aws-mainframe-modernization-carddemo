DEFINE MAPSET(COMODLI) GROUP(CARDMODB)
DESCRIPTION(ACCOUNT DAILY BALANCE LIST MAP)
       RESIDENT(NO) USAGE(NORMAL) USELPACOPY(NO) STATUS(ENABLED)
DEFINE MAPSET(COMODUP) GROUP(CARDMODB)
DESCRIPTION(ACCOUNT DAILY BALANCE DETAIL MAP)
       RESIDENT(NO) USAGE(NORMAL) USELPACOPY(NO) STATUS(ENABLED)
DEFINE PROGRAM(COMODLIC) GROUP(CARDMODB)
DESCRIPTION(ACCOUNT DAILY BALANCE LIST)
       LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
       USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
       TRANSID(CMDL) EXECUTIONSET(FULLAPI)
DEFINE PROGRAM(COMODUPC) GROUP(CARDMODB)
DESCRIPTION(ACCOUNT DAILY BALANCE DETAIL AND FLAG)
       LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
       USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
       TRANSID(CMDU) EXECUTIONSET(FULLAPI)
DEFINE TRANSACTION(CMDL) GROUP(CARDMODB)
DESCRIPTION(LIST ACCOUNT DAILY BALANCES)
       PROGRAM(COMODLIC) TWASIZE(0) PROFILE(DFHCICST) STATUS(ENABLED)
       TASKDATALOC(ANY) TASKDATAKEY(USER) STORAGECLEAR(NO)
       RUNAWAY(SYSTEM) SHUTDOWN(DISABLED) ISOLATE(YES) DYNAMIC(NO)
       PRIORITY(1) TRANCLASS(DFHTCL00) DTIMOUT(NO) RESTART(NO)
       SPURGE(YES) TPURGE(YES) DUMP(YES) TRACE(YES) CONFDATA(NO)
       ACTION(BACKOUT) WAIT(YES) RESSEC(NO) CMDSEC(NO)
DEFINE TRANSACTION(CMDU) GROUP(CARDMODB)
DESCRIPTION(VIEW A DAILY BALANCE AND SET ITS FLAG)
       PROGRAM(COMODUPC) TWASIZE(0) PROFILE(DFHCICST) STATUS(ENABLED)
       TASKDATALOC(ANY) TASKDATAKEY(USER) STORAGECLEAR(NO)
       RUNAWAY(SYSTEM) SHUTDOWN(DISABLED) ISOLATE(YES) DYNAMIC(NO)
       PRIORITY(1) TRANCLASS(DFHTCL00) DTIMOUT(NO) RESTART(NO)
       SPURGE(YES) TPURGE(YES) DUMP(YES) TRACE(YES) CONFDATA(NO)
       ACTION(BACKOUT) WAIT(YES) RESSEC(NO) CMDSEC(NO)
DEFINE DB2ENTRY(CARDMODB) GROUP(CARDMODB)
DESCRIPTION(DB2 ENTRY FOR THE CARDMODB PLAN)
       ACCOUNTREC(TXID) AUTHTYPE(USERID) DROLLBACK(YES) PLAN(CARDMODB)
       PRIORITY(HIGH) PROTECTNUM(0) THREADLIMIT(1) THREADWAIT(YES)
DEFINE DB2TRAN(CMDLTRAN) GROUP(CARDMODB)
DESCRIPTION(DB2TRAN FOR CMDL TRANSACTION)
       ENTRY(CARDMODB) TRANSID(CMDL)
DEFINE DB2TRAN(CMDUTRAN) GROUP(CARDMODB)
DESCRIPTION(DB2TRAN FOR CMDU TRANSACTION)
       ENTRY(CARDMODB) TRANSID(CMDU)
