DEFINE PROGRAM(COMODRQC) GROUP(CARDMODB)
DESCRIPTION(APPLY THE PENDING ACCOUNT REQUESTS)
       LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
       USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
       TRANSID(CMDR) EXECUTIONSET(FULLAPI)
DEFINE TRANSACTION(CMDR) GROUP(CARDMODB)
DESCRIPTION(APPLY THE PENDING ACCOUNT REQUESTS)
       PROGRAM(COMODRQC) TWASIZE(0) PROFILE(DFHCICST) STATUS(ENABLED)
       TASKDATALOC(ANY) TASKDATAKEY(USER) STORAGECLEAR(NO)
       RUNAWAY(SYSTEM) SHUTDOWN(DISABLED) ISOLATE(YES) DYNAMIC(NO)
       PRIORITY(1) TRANCLASS(DFHTCL00) DTIMOUT(NO) RESTART(NO)
       SPURGE(YES) TPURGE(YES) DUMP(YES) TRACE(YES) CONFDATA(NO)
       ACTION(BACKOUT) WAIT(YES) RESSEC(NO) CMDSEC(NO)
DEFINE DB2ENTRY(CARDMODB) GROUP(CARDMODB)
DESCRIPTION(DB2 ENTRY FOR THE CARDMODB PLAN)
       ACCOUNTREC(TXID) AUTHTYPE(USERID) DROLLBACK(YES) PLAN(CARDMODB)
       PRIORITY(HIGH) PROTECTNUM(0) THREADLIMIT(1) THREADWAIT(YES)
DEFINE DB2TRAN(CMDRTRAN) GROUP(CARDMODB)
DESCRIPTION(DB2TRAN FOR CMDR TRANSACTION)
       ENTRY(CARDMODB) TRANSID(CMDR)
