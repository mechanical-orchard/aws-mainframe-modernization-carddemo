//* language governing permissions and limitations under the License
//*********************************************************************
//* UNLOAD THE APP-MO-DB2 TABLES TO DELIMITED FILES:
//*   CARDDEMO.TRAN_HIST       - POSTED TRANSACTION HISTORY
//*   CARDDEMO.ACCT_DAILY_BAL  - ACCOUNT DAILY BALANCE SNAPSHOTS
//*
//* EACH TABLE GETS TWO DATASETS UNDER &HLQ..MODB.UNL.&LBL:
//*   TRANHIST.HDR,  ACCTDBAL.HDR  - ONE RECORD, THE COLUMN NAMES
//*   TRANHIST.DATA, ACCTDBAL.DATA - ONE RECORD PER ROW
//*
//* THE DATA IS IN DB2'S DELIMITED FORMAT, IN EBCDIC: FIELDS SEPARATED
//* BY COMMAS, STRINGS IN DOUBLE QUOTES, NULL AS AN EMPTY FIELD. THE
//* HEADER HAS EACH COLUMN NAME IN DOUBLE QUOTES. A TEXT-MODE DOWNLOAD
//* OF THE HDR DATASET FOLLOWED BY THE DATA DATASET GIVES A CSV FILE
//* WITH A HEADER LINE. THE COLUMNS ARE IN TABLE ORDER, SO KEEP THE
//* HEADERS IN STEP10 AND THE COLUMN LISTS IN STEP20 IN LINE WITH
//* &HLQ..CNTL(MODBCRT).
//*
//* THE UNLOAD READS COMMITTED DATA AND CHANGES NOTHING. TO KEEP THE
//* CONTENTS OF THE TABLES AT EACH STEP OF A CYCLE, RUN THIS JOB
//* BEFORE MODBLOAD AND AFTER EACH OF THE OTHER JOBS, WITH A NEW LBL
//* EACH TIME. A RERUN WITH THE SAME LBL REPLACES ITS DATASETS.
//*
//* THE SUBMITTING USER NEEDS SELECT (OR THE UNLOAD PRIVILEGE) ON BOTH
//* TABLES. IF STEP20 FAILS AND A RERUN REPORTS THAT UTILITY ID
//* MODBUNL IS IN USE, END IT WITH -TERM UTILITY(MODBUNL) FIRST.
//*
//* STEP05 - DELETE THE DATASETS OF AN EARLIER RUN WITH THE SAME LBL
//* STEP10 - WRITE THE HEADER DATASETS (SORT)
//* STEP20 - UNLOAD BOTH TABLES (DB2 UNLOAD UTILITY)
//*
//* RC 0 - BOTH TABLES UNLOADED
//* RC 4 - BOTH TABLES UNLOADED WITH WARNINGS, SEE STEP20 SYSPRINT
//*
//* PREREQUISITES: MODBCRT.
//*********************************************************************
//*  SET PARMS FOR THIS JOB:
//*    HLQ     - HIGH LEVEL QUALIFIER OF THE CARDDEMO DATASETS
//*    LBL     - LABEL OF THIS UNLOAD: 1 TO 5 LETTERS OR DIGITS,
//*              STARTING WITH A LETTER (U1, U2 AND SO ON)
//*    DB2S    - DB2 SUBSYSTEM ID
//*    DB2EXIT - DB2 SDSNEXIT LIBRARY
//*    DB2LOAD - DB2 SDSNLOAD LIBRARY
//*********************************************************************
//   SET HLQ=AWS.M2.CARDDEMO
//   SET LBL=U1
//   SET DB2S=DAZ1
//   SET DB2EXIT=OEM.DB2.&DB2S..SDSNEXIT
//   SET DB2LOAD=OEMA.DB2.VERSIONA.SDSNLOAD
//*********************************************************************
//*  STEP05 : DELETE THE DATASETS OF AN EARLIER RUN WITH THE SAME LBL
//*********************************************************************
//STEP05   EXEC PGM=IEFBR14
//THHDR    DD DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),
//            DSN=&HLQ..MODB.UNL.&LBL..TRANHIST.HDR
//THDATA   DD DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),
//            DSN=&HLQ..MODB.UNL.&LBL..TRANHIST.DATA
//ADHDR    DD DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),
//            DSN=&HLQ..MODB.UNL.&LBL..ACCTDBAL.HDR
//ADDATA   DD DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),
//            DSN=&HLQ..MODB.UNL.&LBL..ACCTDBAL.DATA
//*********************************************************************
//*  STEP10 : WRITE THE HEADER DATASETS. SORT COPIES ONE DUMMY RECORD
//*  TO EACH OUTPUT AS THE HEADER TEXT, CONVERTED TO VARIABLE LENGTH
//*  SO THE LINE HAS NO TRAILING BLANKS
//*********************************************************************
//STEP10   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD *
HEADER
/*
//THHDR    DD DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1),RLSE),
//            DSN=&HLQ..MODB.UNL.&LBL..TRANHIST.HDR
//ADHDR    DD DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1),RLSE),
//            DSN=&HLQ..MODB.UNL.&LBL..ACCTDBAL.HDR
//SYSIN    DD *
  OPTION COPY
  OUTFIL FNAMES=THHDR,FTOV,
    BUILD=(C'"TH_TRAN_ID","TH_ACCT_ID","TH_CARD_NUM",',
           C'"TH_TYPE_CD","TH_CAT_CD","TH_SOURCE","TH_DESC",',
           C'"TH_AMT","TH_MERCHANT_ID","TH_MERCHANT_NAME",',
           C'"TH_MERCHANT_CITY","TH_MERCHANT_ZIP","TH_TRAN_DATE",',
           C'"TH_ORIG_TS","TH_PROC_TS"')
  OUTFIL FNAMES=ADHDR,FTOV,
    BUILD=(C'"ADB_ACCT_ID","ADB_BAL_DATE","ADB_OPEN_BAL",',
           C'"ADB_CREDIT_AMT","ADB_DEBIT_AMT","ADB_CLOSE_BAL",',
           C'"ADB_TRAN_CNT","ADB_CREDIT_LIMIT","ADB_OVERLIMIT_FLG",',
           C'"ADB_FLAG_DATE"')
/*
//*********************************************************************
//*  STEP20 : UNLOAD BOTH TABLES WITH THE DB2 UNLOAD UTILITY. THE
//*  DELIMITERS ARE DB2'S DEFAULTS, SPELLED OUT IN EBCDIC: COMMA,
//*  DOUBLE QUOTE AND PERIOD
//*********************************************************************
//STEP20   EXEC PGM=DSNUTILB,PARM='&DB2S,MODBUNL',COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&DB2EXIT
//         DD DISP=SHR,DSN=&DB2LOAD
//SYSPRINT DD SYSOUT=*
//UTPRINT  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//THDATA   DD DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            DCB=(RECFM=VB,LRECL=32756,BLKSIZE=32760),
//            SPACE=(CYL,(1,1),RLSE),
//            DSN=&HLQ..MODB.UNL.&LBL..TRANHIST.DATA
//ADDATA   DD DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            DCB=(RECFM=VB,LRECL=32756,BLKSIZE=32760),
//            SPACE=(CYL,(1,1),RLSE),
//            DSN=&HLQ..MODB.UNL.&LBL..ACCTDBAL.DATA
//SYSIN    DD *
  UNLOAD DATA FROM TABLE CARDDEMO.TRAN_HIST
    (TH_TRAN_ID, TH_ACCT_ID, TH_CARD_NUM, TH_TYPE_CD, TH_CAT_CD,
     TH_SOURCE, TH_DESC, TH_AMT, TH_MERCHANT_ID, TH_MERCHANT_NAME,
     TH_MERCHANT_CITY, TH_MERCHANT_ZIP, TH_TRAN_DATE, TH_ORIG_TS,
     TH_PROC_TS)
    DELIMITED COLDEL X'6B' CHARDEL X'7F' DECPT X'4B'
    EBCDIC NOSUBS SHRLEVEL CHANGE ISOLATION CS
    UNLDDN THDATA
  UNLOAD DATA FROM TABLE CARDDEMO.ACCT_DAILY_BAL
    (ADB_ACCT_ID, ADB_BAL_DATE, ADB_OPEN_BAL, ADB_CREDIT_AMT,
     ADB_DEBIT_AMT, ADB_CLOSE_BAL, ADB_TRAN_CNT, ADB_CREDIT_LIMIT,
     ADB_OVERLIMIT_FLG, ADB_FLAG_DATE)
    DELIMITED COLDEL X'6B' CHARDEL X'7F' DECPT X'4B'
    EBCDIC NOSUBS SHRLEVEL CHANGE ISOLATION CS
    UNLDDN ADDATA
/*
