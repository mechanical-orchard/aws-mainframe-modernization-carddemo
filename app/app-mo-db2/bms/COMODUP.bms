        TITLE 'ACCOUNT DAILY BALANCE DETAIL'
COMODUP DFHMSD LANG=COBOL,                                             -
               MODE=INOUT,                                             -
               STORAGE=AUTO,                                           -
               TIOAPFX=YES,                                            -
               TYPE=&&SYSPARM
CMODUPA DFHMDI CTRL=(FREEKB),                                          -
               DSATTS=(COLOR,HILIGHT,PS,VALIDN),                       -
               MAPATTS=(COLOR,HILIGHT,PS,VALIDN),                      -
               SIZE=(24,80)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=BLUE,                                             -
               LENGTH=5,                                               -
               POS=(1,1),                                              -
               INITIAL='Tran:'
TRNNAME DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=BLUE,                                             -
               LENGTH=4,                                               -
               POS=(1,7)
TITLE01 DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=YELLOW,                                           -
               LENGTH=40,                                              -
               POS=(1,21)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=BLUE,                                             -
               LENGTH=5,                                               -
               POS=(1,65),                                             -
               INITIAL='Date:'
CURDATE DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=BLUE,                                             -
               LENGTH=8,                                               -
               POS=(1,71),                                             -
               INITIAL='mm/dd/yy'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=BLUE,                                             -
               LENGTH=5,                                               -
               POS=(2,1),                                              -
               INITIAL='Prog:'
PGMNAME DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=BLUE,                                             -
               LENGTH=8,                                               -
               POS=(2,7)
TITLE02 DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=YELLOW,                                           -
               LENGTH=40,                                              -
               POS=(2,21)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=BLUE,                                             -
               LENGTH=5,                                               -
               POS=(2,65),                                             -
               INITIAL='Time:'
CURTIME DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=BLUE,                                             -
               LENGTH=8,                                               -
               POS=(2,71),                                             -
               INITIAL='hh:mm:ss'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=NEUTRAL,                                          -
               LENGTH=28,                                              -
               POS=(4,27),                                             -
               INITIAL='Account Daily Balance Detail'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(6,3),                                              -
               INITIAL='Account ID   :'
ACCTID  DFHMDF ATTRB=(FSET,IC,NORM,UNPROT),                            -
               COLOR=GREEN,                                            -
               HILIGHT=UNDERLINE,                                      -
               LENGTH=11,                                              -
               POS=(6,18)
        DFHMDF LENGTH=0,                                               -
               POS=(6,30)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(6,37),                                             -
               INITIAL='Balance Date :'
BALDATE DFHMDF ATTRB=(FSET,NORM,UNPROT),                               -
               COLOR=GREEN,                                            -
               HILIGHT=UNDERLINE,                                      -
               LENGTH=10,                                              -
               POS=(6,52)
        DFHMDF LENGTH=0,                                               -
               POS=(6,63)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=12,                                              -
               POS=(6,65),                                             -
               INITIAL='(YYYY-MM-DD)'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=NEUTRAL,                                          -
               LENGTH=13,                                              -
               POS=(8,3),                                              -
               INITIAL='Daily balance'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(9,3),                                              -
               INITIAL='Opening bal  :'
OPENBAL DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(9,18)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(9,42),                                             -
               INITIAL='Credit limit :'
CRLIMIT DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(9,57)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(10,3),                                             -
               INITIAL='Credits      :'
CREDITS DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(10,18)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(10,42),                                            -
               INITIAL='Closing bal  :'
CLOSBAL DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(10,57)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(11,3),                                             -
               INITIAL='Debits       :'
DEBITS  DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(11,18)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(11,42),                                            -
               INITIAL='Transactions :'
TRANCNT DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=11,                                              -
               POS=(11,57)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=NEUTRAL,                                          -
               LENGTH=45,                                              -
               POS=(13,3),                                             -
               INITIAL='Transaction history for this account and date'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(14,3),                                             -
               INITIAL='Transactions :'
THCOUNT DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=11,                                              -
               POS=(14,18)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(14,42),                                            -
               INITIAL='Net amount   :'
THNET   DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(14,57)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(15,3),                                             -
               INITIAL='Credits      :'
THCRED  DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(15,18)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(15,42),                                            -
               INITIAL='Debits       :'
THDEBT  DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=14,                                              -
               POS=(15,57)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=NEUTRAL,                                          -
               LENGTH=15,                                              -
               POS=(17,3),                                             -
               INITIAL='Over-limit flag'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(18,3),                                             -
               INITIAL='Current flag :'
CURFLG  DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=1,                                               -
               POS=(18,18)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(18,42),                                            -
               INITIAL='Flagged on   :'
FLGDATE DFHMDF ATTRB=(ASKIP,FSET,NORM),                                -
               COLOR=DEFAULT,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=10,                                              -
               POS=(18,57)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=14,                                              -
               POS=(19,3),                                             -
               INITIAL='New flag Y/N :'
NEWFLG  DFHMDF ATTRB=(FSET,NORM,UNPROT),                               -
               COLOR=GREEN,                                            -
               HILIGHT=UNDERLINE,                                      -
               LENGTH=1,                                               -
               POS=(19,18)
        DFHMDF LENGTH=0,                                               -
               POS=(19,20)
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=NEUTRAL,                                          -
               LENGTH=28,                                              -
               POS=(19,22),                                            -
               INITIAL='Y sets the flag, N clears it'
INFOMSG DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=NEUTRAL,                                          -
               HILIGHT=OFF,                                            -
               LENGTH=60,                                              -
               POS=(21,10)
ERRMSG  DFHMDF ATTRB=(ASKIP,BRT,FSET),                                 -
               COLOR=RED,                                              -
               LENGTH=78,                                              -
               POS=(23,1)
FKEYS   DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=TURQUOISE,                                        -
               LENGTH=22,                                              -
               POS=(24,1),                                             -
               INITIAL='ENTER=Process  F3=Exit'
FKEY05  DFHMDF ATTRB=(ASKIP,DRK),                                      -
               COLOR=TURQUOISE,                                        -
               LENGTH=7,                                               -
               POS=(24,26),                                            -
               INITIAL='F5=Save'
FKEY12  DFHMDF ATTRB=(ASKIP,DRK),                                      -
               COLOR=TURQUOISE,                                        -
               LENGTH=10,                                              -
               POS=(24,36),                                            -
               INITIAL='F12=Cancel'
        DFHMSD TYPE=FINAL
        END
