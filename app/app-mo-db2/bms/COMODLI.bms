               LENGTH=26,                                              -
               POS=(4,28),                                             -
               INITIAL='Account Daily Balance List'
        DFHMDF ATTRB=(ASKIP,NORM),                                     -
               COLOR=NEUTRAL,                                          -
               LENGTH=5,                                               -
               POS=(4,70),                                             -
